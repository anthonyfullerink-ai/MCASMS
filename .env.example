# Missed Call Auto SMS & Pro Automation - Environment Variables Template
# Copy these into your Netlify Site Settings: Site Configuration > Environment variables

# 1. Stripe API Credentials
# Your Stripe secret key (sk_live_... for production, sk_test_... for testing)
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY

# Webhook signing secret from Stripe Dashboard > Developers > Webhooks
# Endpoint: https://missedcallautosms.com/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET

# 2. Resend API Credentials (for automated customer license delivery emails)
# Sign up free at https://resend.com and grab an API key
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# Sender email address (use your verified domain, or onboarding@resend.dev during testing)
FROM_EMAIL=Missed Call Auto SMS <support@missedcallautosms.com>

# Business owner email (receives instant sale notifications upon each Stripe purchase)
OWNER_EMAIL=contactus@offgridmediagroup.com
